# Pew Pew Collection — sample environment configuration
# Copy this file to `.env` and edit values before starting the app.

# Nothing in this file is required. The app starts with no configuration at
# all: it generates its own session key and prints a one-time setup code to the
# container logs so you can create the administrator from the setup page.
# Everything below is an optional override.

# ──────────────────────────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────────────────────────

# Cryptographic key for signing session and CSRF cookies.
# Leave this unset unless you want to manage the key yourself. When it is
# unset the app generates a strong secret on first start, stores it at
# <DATA_DIR>/session-secret with owner-only permissions, and reuses it across
# restarts and upgrades. Startup fails if that file cannot be written — the app
# never falls back to a throwaway key. Generate with: openssl rand -hex 32
# SESSION_SECRET=

# Unattended install: seed the administrator from the environment instead of
# the first-run setup page. Setting ADMIN_PASSWORD skips the setup page
# entirely and forces a password change on first login. The app refuses to
# start in production if it is set to `changeme`.
# Generate with: openssl rand -base64 24
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# HTTP port the server listens on (default: 3000). Must be a whole number
# between 1 and 65535 — the app refuses to start on anything else rather than
# quietly binding a random port. Keep it above 1023: the container runs as a
# non-root user and cannot bind privileged ports.
#
# With docker-compose.yml this one value drives everything — the port the app
# listens on, the published host port, and the health check — so `PORT=3008`
# here serves the app at http://localhost:3008. Plain `docker run` does not read
# this file: pass `-e PORT=3008 -p 3008:3008` instead, or leave PORT alone and
# just remap the host side with `-p 3008:3000`.
# PORT=3000

# Base data directory. Holds the database, the photos/ folder, and the
# generated session-secret file, and bounds where DATABASE_PATH may point
# (default: /data in Docker, ./data otherwise).
# DATA_DIR=/data

# Path to the SQLite database file. Must resolve inside DATA_DIR
# (default: /data/app.db in Docker, ./data/app.db otherwise).
# DATABASE_PATH=/data/app.db

# Set to `true` when running behind an HTTPS reverse proxy (nginx,
# Caddy, Traefik). Required for SECURE_COOKIES=true to function.
# TRUST_PROXY=false

# Set to `true` when serving the app over HTTPS. Requires
# TRUST_PROXY=true behind a reverse proxy.
# SECURE_COOKIES=false

# Opt-in: check GitHub Releases for new app versions (cached 14 days).
# UPDATE_CHECK=false
