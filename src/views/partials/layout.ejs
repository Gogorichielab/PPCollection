<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'dark' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- SEO -->
  <meta name="description" content="Pew Pew Collection — a self-hosted, privacy-first firearm inventory manager. Runs locally. Your data stays yours.">
  <meta name="robots" content="index, follow">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Pew Pew Collection">
  <meta property="og:title" content="<%= pageTitle ? pageTitle + ' — Pew Pew Collection' : 'Pew Pew Collection' %>">
  <meta property="og:description" content="A self-hosted, privacy-first firearm inventory manager. Runs locally. Your data stays yours.">
  <meta property="og:url" content="">
  <!-- TODO: add /static/img/og-image.png (1200x630) and enable the image tags below. -->
  <!-- <meta property="og:image" content="/static/img/og-image.png"> -->

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle ? pageTitle + ' — Pew Pew Collection' : 'Pew Pew Collection' %>">
  <meta name="twitter:description" content="A self-hosted, privacy-first firearm inventory manager. Runs locally. Your data stays yours.">
  <!-- <meta name="twitter:image" content="/static/img/og-image.png"> -->
  <title><%= pageTitle ? pageTitle + ' — ' : '' %>Pew Pew Collection</title>
  <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %> <%= typeof pageClass !== 'undefined' && (pageClass === 'page-home' || pageClass === 'print-report') ? '' : 'page-ledger' %>">
  <a class="skip-link" href="#main">Skip to main content</a>
  <% if (csrfToken) { %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" id="csrf-token">
  <% } %>
  <% const isHome = currentPath === '/' || currentPath === '/home'; %>
  <% const isFirearms = currentPath && currentPath.startsWith('/firearms'); %>
  <% const isAmmo = currentPath && currentPath.startsWith('/ammo'); %>
  <% const isReports = currentPath && currentPath.startsWith('/reports'); %>
  <% const isProfile = currentPath && currentPath.startsWith('/profile'); %>
  <% const isAuthPage = typeof pageClass !== 'undefined' && pageClass === 'page-auth'; %>
  <header class="topbar">
    <div class="container">
      <div class="brand-group">
        <h1><a href="/">Pew Pew Collection</a></h1>
        <% if (!isAuthPage) { %>
        <nav class="primary-nav" aria-label="Primary">
          <a
            class="nav-link <%= isHome ? 'active' : '' %>"
            href="/"
            <% if (isHome) { %>aria-current="page"<% } %>
          >Overview</a>
          <a
            class="nav-link <%= isFirearms ? 'active' : '' %>"
            href="/firearms"
            <% if (isFirearms) { %>aria-current="page"<% } %>
          >Firearms</a>
          <a
            class="nav-link <%= isAmmo ? 'active' : '' %>"
            href="/ammo"
            <% if (isAmmo) { %>aria-current="page"<% } %>
          >Ammo</a>
          <a
            class="nav-link <%= isReports ? 'active' : '' %>"
            href="/reports"
            <% if (isReports) { %>aria-current="page"<% } %>
          >Collection Stats</a>
          <a
            class="nav-link <%= isProfile ? 'active' : '' %>"
            href="/profile"
            <% if (isProfile) { %>aria-current="page"<% } %>
          >Settings</a>
        </nav>
        <% } %>
      </div>
      <div class="header-controls">
        <% if (user && !isAuthPage) { %>
          <details class="add-item">
            <summary class="btn btn-primary"><span aria-hidden="true">+</span> Add item <span aria-hidden="true">▾</span></summary>
            <div class="add-item-links">
              <a href="/firearms/new">Add firearm</a>
              <a href="/ammo/new">Add ammo</a>
            </div>
          </details>
        <% } %>
        <button
          id="theme-toggle"
          class="btn btn-secondary"
          aria-label="<%= theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode' %>"
        >
          <span class="theme-icon" aria-hidden="true">☀️</span>
        </button>
        <% if (user) { %>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-secondary" type="submit">Logout (<%= user.username %>)</button>
        </form>
        <% } %>
      </div>
    </div>
  </header>
  <main id="main" class="container" tabindex="-1">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash flash-<%= flash.type || 'info' %>" role="status" aria-live="polite">
        <%= flash.message %>
      </div>
    <% } %>
    <%- body %>
  </main>
  <footer class="app-footer">
    <div class="container footer-inner">
      <span class="footer-version">PPCollection v<%= versionInfo.currentVersion %></span>
      <% if (user && !isAuthPage) { %>
        <a href="https://github.com/Gogorichielab/PPCollection/issues"
           target="_blank" rel="noopener noreferrer">Feedback <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      <% } %>
      <% if (updateCheckAllowed && updateCheckEnabled && versionInfo.updateAvailable) { %>
        <a class="footer-update-badge"
           href="https://github.com/Gogorichielab/PPCollection/releases/latest"
           target="_blank" rel="noopener noreferrer">
          v<%= versionInfo.latestVersion %> available — view release
        </a>
      <% } %>
    </div>
  </footer>
  <script src="/static/js/theme.js"></script>
  <% if (user && !isAuthPage) { %>
  <script src="/static/js/add-item.js"></script>
  <% } %>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="<%= pageScript %>"></script>
  <% } %>
  <% if (typeof pageScripts !== 'undefined' && Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach((scriptPath) => { %>
  <script src="<%= scriptPath %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
