<section class="app-hero home-hero" aria-labelledby="overview-title">
  <div class="home-intro">
    <div>
      <p class="home-hero-tag label-caps">Your personal collection ledger</p>
      <h2 id="overview-title" class="home-hero-title">Collection Overview</h2>
      <p class="home-hero-subtitle">Welcome back, <%= username %>. A clear record of what you own and what needs attention.</p>
    </div>
    <a class="btn btn-primary" href="/firearms/new"><span aria-hidden="true">+</span> Add firearm</a>
  </div>
  <div class="home-stats" role="list" aria-label="Collection statistics">
    <div class="home-stat home-stat-total" role="listitem">
      <a class="home-total-link" href="/firearms">
        <span class="home-stat-label">Collection records</span>
        <span class="home-stat-value"><%= stats.totalFirearms %></span>
        <span class="home-stat-note">Firearms · Open inventory <span aria-hidden="true">↗</span></span>
      </a>
    </div>
    <div class="home-stat" role="listitem">
      <span class="home-stat-label">Added this month</span>
      <span class="home-stat-value"><%= stats.thisMonth %></span>
      <span class="home-stat-note">New records</span>
    </div>
    <div class="home-stat" role="listitem">
      <span class="home-stat-label">Collection types</span>
      <span class="home-stat-value"><%= stats.categories %></span>
      <span class="home-stat-note">Across your inventory</span>
    </div>
    <div class="home-stat" role="listitem">
      <span class="home-stat-label">Last updated</span>
      <span class="home-stat-value"><%= stats.lastUpdateDays %></span>
      <span class="home-stat-note"><%= stats.lastUpdateDays === '—' ? 'No records yet' : 'Since your latest change' %></span>
    </div>
  </div>
</section>

<div class="home-workspace">
  <section class="home-ledger" aria-labelledby="activity-title">
    <header class="home-section-heading">
      <div><p class="label-caps">01 / The record</p><h3 id="activity-title">Recent activity</h3></div>
      <a class="home-text-link" href="/firearms">View inventory <span aria-hidden="true">↗</span></a>
    </header>
    <% if (!recentActivity.length) { %>
      <div class="home-empty">
        <h4>Every collection starts with one record.</h4>
        <p>Add your first firearm to keep its details, photos, and maintenance history together.</p>
        <a class="home-text-link" href="/firearms/new">Create your first record →</a>
      </div>
    <% } else { %>
      <ol class="home-activity-list">
        <% recentActivity.forEach((activity) => { %>
          <li class="activity-row">
            <span class="activity-dot <%= activity.isRecent ? 'is-recent' : '' %>" aria-hidden="true"></span>
            <a class="activity-description" href="/firearms/<%= activity.id %>"><%= activity.description %></a>
            <% if (activity.isRecent) { %><span class="activity-new-badge">New</span><% } %>
            <span class="activity-time"><%= activity.timeAgo %></span>
          </li>
        <% }) %>
      </ol>
    <% } %>
    <nav class="home-shortcuts" aria-label="Collection tools">
      <a href="/ammo"><span class="label-caps">Supplies</span><span>Ammo inventory <span aria-hidden="true">↗</span></span></a>
      <a href="/reports"><span class="label-caps">Insights</span><span>Collection stats <span aria-hidden="true">↗</span></span></a>
    </nav>
  </section>

  <section class="home-care" aria-labelledby="care-title">
    <p class="label-caps">02 / Care & upkeep</p>
    <div class="home-care-heading"><h3 id="care-title">Due for cleaning</h3><span class="home-care-count"><%= stats.dueForCleaning %></span></div>
    <% if (typeof cleaningDue !== 'undefined' && cleaningDue && cleaningDue.length) { %>
      <p class="home-care-intro">Open a record to review its maintenance log.</p>
      <ul class="home-care-list">
        <% cleaningDue.forEach((entry) => { %>
          <li><a href="/firearms/<%= entry.id %>"><span><%= entry.label %></span><span aria-hidden="true">↗</span></a><p><%= entry.reason %></p></li>
        <% }) %>
      </ul>
      <% if (stats.dueForCleaning > cleaningDue.length) { %><p class="home-care-intro">Showing <%= cleaningDue.length %> of <%= stats.dueForCleaning %> records due for cleaning. <a href="/firearms">View inventory</a>.</p><% } %>
    <% } else { %>
      <p class="home-care-intro"><%= stats.totalFirearms ? 'No cleaning reminders right now. Log maintenance in each firearm’s record to keep its history up to date.' : 'Cleaning reminders will appear here as you build your collection.' %></p>
    <% } %>
    <a class="home-text-link" href="/profile">Reminder settings →</a>
  </section>
</div>

<section class="home-chart-section" aria-labelledby="patterns-title">
  <header class="home-section-heading"><div><p class="label-caps">03 / A wider view</p><h3 id="patterns-title">Your collection, in perspective</h3></div></header>
  <div class="home-chart-row">
    <article class="home-chart-panel">
      <h4>Cumulative purchase value</h4>
      <p class="home-chart-caption">Running total of recorded purchase prices through each year. Not a current appraisal.</p>
      <% if (!charts.valueByYear.length) { %>
        <p class="home-chart-empty">Add purchase dates and prices to your records to see them here. <a href="/firearms">View inventory</a>.</p>
      <% } else { %>
        <div class="home-chart-wrap"><canvas id="collection-value-chart" aria-label="Cumulative purchase value by year. Exact values follow in the table." role="img"></canvas></div>
        <details class="home-chart-data">
          <summary>View purchase values</summary>
          <table>
            <caption class="visually-hidden">Cumulative purchase value by year</caption>
            <thead><tr><th scope="col">Year</th><th scope="col">Cumulative value</th></tr></thead>
            <tbody>
              <% charts.valueByYear.forEach((item) => { %>
                <tr><th scope="row"><%= item.year %></th><td><%= Number(item.total_value).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>
    <article class="home-chart-panel">
      <h4>Collection by type</h4>
      <p class="home-chart-caption">A breakdown of the firearms in your records.</p>
      <% if (!charts.typeBreakdown.length) { %>
        <% if (stats.totalFirearms) { %>
          <p class="home-chart-empty">Add a firearm type to your records to see the breakdown. <a href="/firearms">View inventory</a>.</p>
        <% } else { %>
          <p class="home-chart-empty">Your collection breakdown starts with your first record. <a href="/firearms/new">Add a firearm</a>.</p>
        <% } %>
      <% } else { %>
        <ul class="home-type-ledger">
          <% charts.typeBreakdown.forEach((item) => { %>
            <li>
              <span><%= item.firearm_type %></span><strong><%= item.count %></strong>
              <meter min="0" max="<%= Math.max(1, stats.totalFirearms) %>" value="<%= item.count %>" aria-label="<%= item.firearm_type %> as a share of your collection"><%= item.count %> of <%= stats.totalFirearms %></meter>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </article>
  </div>
</section>
<script type="application/json" id="home-charts-data"><%- JSON.stringify(charts).replace(/</g, '\\u003c') %></script>
