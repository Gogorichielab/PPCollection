<div class="auth-shell auth-shell-setup">
  <section class="auth-intro" aria-labelledby="setup-title">
    <p class="eyebrow">First-run setup</p>
    <h2 class="page-title" id="setup-title">Begin your private collection ledger.</h2>
    <p class="page-subtitle">Create the administrator account that will protect this installation and its records.</p>
    <ol class="auth-steps" aria-label="Setup steps">
      <li><span>1</span><strong>Verify this install</strong><small>Enter the one-time code from your container logs.</small></li>
      <li><span>2</span><strong>Create your account</strong><small>Choose the credentials you will use locally.</small></li>
      <li><span>3</span><strong>Start your ledger</strong><small>Add your first record from the collection dashboard.</small></li>
    </ol>
  </section>

  <section class="card login-card" aria-labelledby="create-admin-title">
    <header class="auth-card-header">
      <div>
        <p class="eyebrow">Administrator account</p>
        <h3 class="card-title" id="create-admin-title">Create Administrator</h3>
      </div>
      <span class="auth-status">Step 1 of 1</span>
    </header>
    <p class="security-message">
      Find the setup code in your container logs with <code>docker logs ppcollection</code>.
      This code can only be used during initial setup.
    </p>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form method="post" action="/setup" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Setup Code
        <input
          type="text"
          name="setup_code"
          required
          autocomplete="one-time-code"
          spellcheck="false"
          placeholder="XXXX-XXXX-XXXX"
          class="setup-code-input"
        >
      </label>
      <label>
        Username (minimum <%= minUsernameLength %> characters)
        <input
          type="text"
          name="username"
          required
          minlength="<%= minUsernameLength %>"
          value="<%= usernameValue %>"
          autocomplete="username"
        >
      </label>
      <label>
        Password (minimum <%= minPasswordLength %> characters)
        <input type="password" name="password" required minlength="<%= minPasswordLength %>" autocomplete="new-password">
      </label>
      <label>
        Confirm Password
        <input type="password" name="confirm_password" required minlength="<%= minPasswordLength %>" autocomplete="new-password">
      </label>
      <div class="form-actions settings-form-actions">
        <button class="btn auth-submit" type="submit">Create Account &amp; Open Collection</button>
      </div>
    </form>
  </section>
</div>
