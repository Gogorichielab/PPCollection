<div data-inventory-summary>
  <section class="app-hero">
    <p class="label-caps">Collection</p>
    <h2 class="page-title">Firearms</h2>
    <p class="page-subtitle meta">A searchable record of your collection, its status, and its history.</p>
  </section>

  <div class="action-bar page-section panel">
    <div class="title-group">
      <p class="label-caps">Collection ledger</p>
      <h3 class="card-title">Firearm records</h3>
      <small class="meta"><%= pagination.totalCount %> item<%= pagination.totalCount === 1 ? '' : 's' %> on record</small>
    </div>
    <div class="action-bar-actions">
      <a class="btn btn-secondary" href="/firearms/import">Import CSV</a>
      <a class="btn btn-secondary" href="/firearms/export<%= queryString ? '?' + queryString : '' %>" download="firearms.csv">Export CSV (<%= pagination.totalCount %> <%= pagination.totalCount === 1 ? 'record' : 'records' %>)</a>
      <a class="btn btn-secondary" href="/firearms/report">Insurance Report</a>
      <% if (items.length > 0) { %>
        <a class="btn btn-primary" href="/firearms/new">+ Add firearm</a>
      <% } %>
    </div>
  </div>

</div>
    <% function getStatusBadgeClass(value) {
      const normalized = String(value || '').trim().toLowerCase();
      if (normalized === 'active') return 'badge-active';
      if (normalized === 'in transit') return 'badge-transit';
      if (normalized === 'sold') return 'badge-sold';
      if (normalized === 'under repair' || normalized === 'repair' || normalized === 'maintenance') return 'badge-repair';
      if (normalized === 'lost' || normalized === 'lost/stolen' || normalized === 'stolen') return 'badge-lost';
      return 'badge-accent';
    } %>
  <%- include('../partials/inventory-filters', { ...locals, listPath: '/firearms', listName: 'firearms' }) %>
  <div data-inventory-results aria-live="polite">
  <% if (!items.length) { %>
    <section class="card empty-state panel">
      <% if (hasFilters) { %>
        <h3>No matching firearms</h3>
        <a href="/firearms">Clear filters</a>
      <% } else { %>
        <h3>No firearms yet</h3>
        <p class="meta">Add your first record to start tracking your collection.</p>
      <% } %>
      <div class="empty-state-actions">
        <a class="btn btn-primary" href="/firearms/new">Add Firearm</a>
      </div>
    </section>
  <% } else { %>
    <div class="table-wrapper panel">
      <div id="results-status" class="visually-hidden" role="status" aria-live="polite"></div>
      <table class="table">
        <%- include('../partials/inventory-head', { columns: {
          make: 'Make', model: 'Model', caliber: 'Caliber', serial: 'Serial', purchase_date: 'Purchase Date', status: 'Status', firearm_type: 'Type'
        }, sort, queryString }) %>
        <tbody id="firearms-tbody">
        <% items.forEach((i, rowIdx) => { %>
          <tr
            class="table-row-clickable"
            data-firearm-id="<%= i.id %>"
            data-make="<%= i.make %>"
            data-model="<%= i.model %>"
            data-caliber="<%= i.caliber || '' %>"
            data-serial="<%= i.serial || '' %>"
            data-status="<%= i.status || '' %>"
            data-condition="<%= i.condition || '' %>"
            data-firearm_type="<%= i.firearm_type || '' %>"
            data-purchase_date="<%= i.purchase_date || '' %>"
            tabindex="<%= rowIdx === 0 ? '0' : '-1' %>"
            role="link"
            aria-label="View details for <%= i.make %> <%= i.model %>"
          >
            <td data-label="Make"><%= i.make %></td>
            <td data-label="Model"><%= i.model %></td>
            <td class="mono" data-label="Caliber">
              <% if (i.caliber) { %>
                <%= i.caliber %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td class="mono" data-label="Serial">
              <% if (i.serial) { %>
                <%= i.serial %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td class="mono" data-label="Purchase Date">
              <% if (i.purchase_date) { %>
                <%= i.purchase_date %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td data-label="Status">
              <% if (i.status) { %>
                <span class="badge badge-accent <%= getStatusBadgeClass(i.status) %>"><%= i.status %></span>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td data-label="Type">
              <% if (i.firearm_type) { %>
                <span class="badge badge-outline label-caps"><%= i.firearm_type %></span>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td class="text-right table-row-actions"><a class="link-subtle" href="/firearms/<%= i.id %>">Details</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/inventory-pagination', { pagination, queryString }) %>
  <% } %>

  </div>
  <script src="/static/js/inventory-search.js"></script>
