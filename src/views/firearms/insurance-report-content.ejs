  <section class="app-hero no-print">
    <p class="label-caps">Inventory</p>
    <h2 class="page-title">Insurance Report</h2>
    <p class="page-subtitle meta">Full inventory snapshot for insurance documentation.</p>
  </section>

  <form id="report-options" class="page-section panel no-print" method="get" action="/firearms/report">
    <fieldset>
      <legend>Include in insurance report</legend>
      <input type="hidden" name="custom" value="1">
      <% for (const [key, label] of [['serial', 'Serial numbers'], ['location', 'Storage locations'], ['value', 'Purchase values'], ['ammunition', 'Ammunition']]) { %>
        <label><input type="checkbox" name="<%= key %>" value="1" <%= options[key] ? 'checked' : '' %>> <%= label %></label>
      <% } %>
      <button class="btn btn-secondary" type="submit">Update preview</button>
    </fieldset>
  </form>
  <div class="action-bar page-section panel no-print">
    <div class="title-group">
      <p class="label-caps">Report</p>
      <h3 class="card-title">Insurance Report</h3>
      <small class="meta"><%= items.length %> item<%= items.length === 1 ? '' : 's' %> on record</small>
    </div>
    <div class="action-bar-actions">
      <a class="btn btn-secondary" href="/firearms">&#8592; Back to firearms</a>
      <button type="submit" form="report-options" name="print" value="1" class="btn btn-primary">Print Report</button>
    </div>
  </div>

  <div class="report-header print-only">
    <h2 class="report-title">Insurance Report &mdash; Pew Pew Collection</h2>
    <p class="report-meta">Generated: <%= reportDate %> &nbsp;&bull;&nbsp; <%= items.length %> item<%= items.length === 1 ? '' : 's' %></p>
  </div>

  <% if (!items.length) { %>
    <section class="card empty-state panel no-print">
      <h3>No firearms on record</h3>
      <p class="meta">Add firearms to your inventory before generating a report.</p>
      <div class="empty-state-actions">
        <a class="btn btn-primary" href="/firearms/new">Add Firearm</a>
      </div>
    </section>
  <% } else { %>
    <div class="table-wrapper panel">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Make</th>
            <th scope="col">Model</th>
            <th scope="col">Type</th>
            <th scope="col">Caliber</th>
            <% if (options.serial) { %><th scope="col">Serial Number</th><% } %>
            <% if (options.location) { %><th scope="col">Location</th><% } %>
            <th scope="col">Condition</th>
            <th scope="col">Status</th>
            <th scope="col">Purchase Date</th>
            <% if (options.value) { %><th scope="col">Purchase Value</th><% } %>
          </tr>
        </thead>
        <tbody>
        <% items.forEach((item, index) => { %>
          <tr>
            <td class="mono" data-label="#"><%- index + 1 %></td>
            <td data-label="Make"><%= item.make %></td>
            <td data-label="Model"><%= item.model %></td>
            <td data-label="Type">
              <% if (item.firearm_type) { %>
                <%= item.firearm_type %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td class="mono" data-label="Caliber">
              <% if (item.caliber) { %>
                <%= item.caliber %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <% if (options.serial) { %><td class="mono" data-label="Serial Number">
              <% if (item.serial) { %>
                <%= item.serial %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td><% } %>
            <% if (options.location) { %><td data-label="Location"><%= item.location || '-' %></td><% } %>
            <td data-label="Condition">
              <% if (item.condition) { %>
                <%= item.condition %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td data-label="Status">
              <% if (item.status) { %>
                <%= item.status %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <td class="mono" data-label="Purchase Date">
              <% if (item.purchase_date) { %>
                <%= item.purchase_date %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td>
            <% if (options.value) { %><td class="mono" data-label="Purchase Value">
              <% if (item.purchase_price != null && item.purchase_price !== '') { %>
                $<%= Number(item.purchase_price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              <% } else { %>
                <span class="muted-text meta">-</span>
              <% } %>
            </td><% } %>
          </tr>
        <% }) %>
        </tbody>
        <% if (options.value) { %><tfoot>
          <tr class="report-total-row">
            <td colspan="<%= 8 + Number(options.serial) + Number(options.location) %>" class="text-right"><strong>Total Purchase Value</strong></td>
            <td class="mono"><strong>$<%= Number(totalValue).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></td>
          </tr>
        </tfoot><% } %>
      </table>
    </div>
  <% } %>

  <% if (typeof ammo !== 'undefined' && ammo.length) { %>
    <div class="page-section panel">
      <div class="title-group">
        <p class="label-caps">Supplies</p>
        <h3 class="card-title">Ammunition</h3>
        <small class="meta"><%= ammo.length %> lot<%= ammo.length === 1 ? '' : 's' %> &bull; <%= ammoTotalRounds.toLocaleString('en-US') %> rounds<% if (options.value) { %> &bull; not included in purchase value total<% } %></small>
      </div>
    </div>
    <div class="table-wrapper panel">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Manufacturer</th>
            <th scope="col">Product</th>
            <th scope="col">Caliber</th>
            <th scope="col">Grain/Load</th>
            <th scope="col">Boxes</th>
            <th scope="col">Total Rounds</th>
            <% if (options.location) { %><th scope="col">Location</th><% } %>
          </tr>
        </thead>
        <tbody>
        <% ammo.forEach((a, index) => { %>
          <tr>
            <td class="mono" data-label="#"><%- index + 1 %></td>
            <td data-label="Manufacturer"><%= a.manufacturer %></td>
            <td data-label="Product"><%= a.product_line || '-' %></td>
            <td class="mono" data-label="Caliber"><%= a.caliber %></td>
            <td data-label="Grain/Load"><%= [a.grain ? `${a.grain} gr` : '', a.load_type].filter(Boolean).join(' · ') || '-' %></td>
            <td class="mono" data-label="Boxes"><%= a.boxes %></td>
            <td class="mono" data-label="Total Rounds"><%= a.total_rounds.toLocaleString('en-US') %></td>
            <% if (options.location) { %><td data-label="Location"><%= a.location || '-' %></td><% } %>
          </tr>
        <% }) %>
        </tbody>
        <tfoot>
          <tr class="report-total-row">
            <td colspan="6" class="text-right"><strong>Total Rounds</strong></td>
            <td class="mono"><strong><%= ammoTotalRounds.toLocaleString('en-US') %></strong></td>
            <% if (options.location) { %><td></td><% } %>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
